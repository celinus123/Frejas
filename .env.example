# Copy to .env.local for local development. In Vercel, add these under Settings → Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Server only. Never prefix with NEXT_PUBLIC_. Used solely to delete accounts.
SUPABASE_SECRET_KEY=your-secret-or-service-role-key
